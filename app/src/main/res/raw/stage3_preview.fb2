    <body>
        <title>
            <p>Quiet Pages</p>
        </title>
        <epigraph>
            <p>A page begins as silence.</p>
            <text-author>Open Book Workshop</text-author>
        </epigraph>
        <section id="chapter-one">
            <title>
                <p>Chapter One</p>
            </title>
            <p>This is <emphasis>real parsed text</emphasis>, with a
                <strong>format-neutral model</strong> and a
                <a l:href="#note-one" type="note">basic note</a>.</p>
            <subtitle>A small subtitle</subtitle>
            <cite>
                <p>Unknown presentation details stay outside the parser.</p>
                <text-author>Architecture note</text-author>
            </cite>
            <poem>
                <title><p>Paper</p></title>
                <stanza>
                    <v>White leaf, quiet light,</v>
                    <v>Words wait for the reader.</v>
                </stanza>
                <text-author>Listai</text-author>
            </poem>
            <image l:href="#cover" alt="A tiny cover fixture" />
            <empty-line />
            <section id="chapter-one-detail">
                <title><p>A Nested Section</p></title>
                <p>Its location is also represented in the table of contents.</p>
            </section>
        </section>
    </body>
    <body name="notes">
        <section id="note-one">
            <title><p>Note 1</p></title>
            <p>A note remains addressable without becoming a main-body block.</p>
        </section>
    </body>
